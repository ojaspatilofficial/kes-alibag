# ==========================================================
# Konkan Education Society, Alibag — website configuration
# Copy this file to `.env` and fill in the values.
# Nothing in this file is sent to the browser except variables starting with VITE_.
# ==========================================================

# MongoDB connection (local MongoDB service by default; MongoDB Atlas on Vercel)
MONGODB_URI=mongodb://127.0.0.1:27017/kes_alibag

# Port for the API server (must match the proxy in vite.config.ts)
API_PORT=5050

# Long random text used to sign admin logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# First admin account — created automatically the first time the server starts.
# The password can be changed later from the dashboard (Settings → Change password).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Public URL of this website, used in sitemap.xml and canonical links (e.g. https://www.kesalibag.edu.in)
SITE_URL=

# Only on Vercel: added automatically when you connect a Vercel Blob store.
# BLOB_READ_WRITE_TOKEN=

{
  "name": "kes-alibag-org-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,yellow \"npm:server\" \"npm:web\"",
    "web": "vite",
    "server": "node scripts/export-data.mjs && node server/index.js",
    "build": "node scripts/export-data.mjs && node scripts/sitemap.mjs && tsc -b && vite build",
    "start": "node server/index.js",
    "seed": "node scripts/export-data.mjs && node server/seed.js",
    "seed:reset": "node scripts/export-data.mjs && node server/seed.js --reset",
    "images": "node scripts/images.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^12.43.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.28.0",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.5",
    "oxlint": "^1.77.0",
    "postcss": "^8.5.25",
    "sharp": "^0.34.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": "22.x"
  }
}
